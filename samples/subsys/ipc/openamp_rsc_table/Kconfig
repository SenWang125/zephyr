mainmenu "OpenAMP resource table sample"

config APP_TASK_STACK_SIZE
	int "Stack size of the manager and client threads"
	default 1024
	help
	  A core that saves a large register file on a call needs more than
	  the default.

config APP_TTY_TASK_STACK_SIZE
	int "Stack size of the TTY thread"
	default 1536

source "Kconfig.zephyr"
