/ {
	chosen {
		zephyr,ipc = &ipm0;
		zephyr,ipc_shm = &ddr_ipc;
	};

	ipm0: ipm0 {
		compatible = "zephyr,mbox-ipm";
		mboxes = <&mailbox_c7x 0>, <&mailbox_c7x 1>;
		mbox-names = "tx", "rx";
		status = "okay";
	};
};
