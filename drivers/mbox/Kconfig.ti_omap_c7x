config MBOX_TI_OMAP_C7X
	bool "TI OMAP HW mailbox (C7x)"
	default y
	depends on MBOX
	depends on DT_HAS_TI_OMAP_MAILBOX_C7X_ENABLED
	select DYNAMIC_INTERRUPTS
	help
	  TI OMAP-style hardware mailbox driver for a C7x DSP, receiving on the
	  CLEC interrupt named in devicetree.
