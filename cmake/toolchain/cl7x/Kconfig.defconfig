# cl7x warns "unknown attribute" and drops it, so the handler never runs.
config TOOLCHAIN_SUPPORTS_VARIABLE_CLEANUP_ATTRIBUTE
	default n

# cl7x has no --c17.
choice STD_C
	default STD_C11
endchoice

# The init-priority check reads an ET_EXEC ELF, which the cl7x link does not produce.
config CHECK_INIT_PRIORITIES
	default n

# cl7x has no -fmacro-prefix-map, so __FILE__ paths cannot be stripped.
config BUILD_OUTPUT_STRIP_PATHS
	default n

# lib/libc/Kconfig selects PICOLIBC when the module is present, ignoring
# TOOLCHAIN_HAS_PICOLIBC. cl7x cannot build it.
config PICOLIBC_SUPPORTED
	default n
